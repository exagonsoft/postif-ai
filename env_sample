# Required: use deployment secrets, never commit populated environment files.
# Generate independent values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=
WORKER_SECRET=
# In-app worker sweep limit; optional, 5000-25000 milliseconds.
# WORKER_BUDGET_MS=24000

# Required: MongoDB Atlas or a replica set, plus an explicit database name.
MONGODB_URI=
MONGODB_DB=

# Required: public HTTPS origin, also used for SEO canonical URLs, sitemap and social images.
# Set the canonical production domain on deployment; loopback HTTP is for local testing only.
APP_URL=
# Production on Amplify: SDK default credential chain uses the SSR Compute role.
MEDIA_STORAGE_PROVIDER=s3
S3_MEDIA_REGION=sa-east-1
S3_MEDIA_BUCKET=
S3_MEDIA_PREFIX=media/
# Local development: select local and optionally set an absolute directory.
# Not required for S3; never use Amplify's ephemeral disk for permanent storage.
# MEDIA_STORAGE_DIR=

# Optional Managed AI. Customers can configure encrypted OpenAI BYOK in their workspace.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# Text-capable orchestrator for durable background image-generation responses.
# OPENAI_IMAGE_RESPONSE_MODEL=gpt-5.2
RUNWAY_API_KEY=
# FFmpeg is required for GIF generation and PNG/WebP-to-JPEG conversion for Instagram.
# FFMPEG_PATH=

# Sandbox first. Publish subscription products/plans in the operator admin panel.
# Enable only after configuring PayPal credentials and a real app webhook.
BILLING_ENABLED=false
BILLING_APP_URL=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# SMTP also enables email verification and password recovery.
# Configure each optional notification group completely, or leave it empty.
SMTP_URL=
MAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Managed social OAuth: optional until the respective provider is explicitly enabled.
# Comma-separated identifiers: facebook,instagram,linkedin,x,tiktok,pinterest,youtube,threads.
# Enabling requires the corresponding server client ID/secret and a public HTTPS APP_URL.
# Approval lists are operator attestations, NOT provider approval or verification.
SOCIAL_MANAGED_PROVIDERS=
SOCIAL_OAUTH_APPROVED_PROVIDERS=
# Request additional reviewed analytics scopes only after user opt-in.
SOCIAL_OAUTH_ANALYTICS_PROVIDERS=
# Only tiktok,youtube: configure only AFTER their public-posting audit is approved.
SOCIAL_OAUTH_PUBLIC_POSTING_PROVIDERS=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
# Optional Facebook Login for Business configuration using a User access token.
FACEBOOK_OAUTH_CONFIG_ID=
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
# Required YYYYMM when managed LinkedIn is enabled; use an actually supported version.
LINKEDIN_API_VERSION=
# LinkedIn organizations additionally require approved Community Management access.
LINKEDIN_ORGANIZATIONS_ENABLED=false
META_GRAPH_API_VERSION=v27.0
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# TikTok calls its OAuth client ID the client key.
TIKTOK_OAUTH_CLIENT_ID=
TIKTOK_OAUTH_CLIENT_SECRET=
PINTEREST_OAUTH_CLIENT_ID=
PINTEREST_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
THREADS_OAUTH_CLIENT_ID=
THREADS_OAUTH_CLIENT_SECRET=
# No customer access/refresh tokens belong here. Advanced workspace credentials remain
# encrypted in MongoDB; social OAuth BYO applications are independent of AI BYOK plans.
# See docs/SOCIAL_MANAGED_OAUTH_MIGRATION.md for setup and exact callback URLs.
# Platform administrator access is a users.systemRole value, not an environment credential.
# Run npm run admin:create for an account-only operator; no workspace or branding is created.
